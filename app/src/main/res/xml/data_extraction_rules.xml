<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Allowlist mode: only back up app preferences (theme, reminder time).
         Database is excluded implicitly — Firestore re-syncs it on sign-in. -->
    <cloud-backup>
        <include domain="sharedpref" path="aura_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="aura_prefs.xml" />
    </device-transfer>
</data-extraction-rules>