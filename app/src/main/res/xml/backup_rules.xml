<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Room DB is excluded — Firestore is the source of truth and re-syncs on sign-in -->
    <exclude domain="database" path="aura.db" />
    <exclude domain="database" path="aura.db-shm" />
    <exclude domain="database" path="aura.db-wal" />
    <!-- Back up app preferences (theme, reminder time) -->
    <include domain="sharedpref" path="aura_prefs.xml" />
</full-backup-content>